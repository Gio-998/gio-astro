{
  "routes": [
    { "src": "/en/(premium|upgrade)/?", "status": 308, "headers": { "Location": "/en/pricing/" } },
    { "src": "/mk/(premium|upgrade)/?", "status": 308, "headers": { "Location": "/mk/ceni/" } },
    { "src": "/en/ceni/?", "status": 308, "headers": { "Location": "/en/pricing/" } },
    { "src": "/mk/pricing/?", "status": 308, "headers": { "Location": "/mk/ceni/" } },
    { "src": "/en/dneven-horoskop(?:/.*)?", "status": 308, "headers": { "Location": "/en/horoscope/" } },
    { "src": "/mk/horoscope(?:/.*)?", "status": 308, "headers": { "Location": "/mk/dneven-horoskop/" } },
    { "handle": "filesystem" },
    { "src": "/invite/[a-zA-Z0-9]{8}/?", "dest": "/en/invite/" },
    { "src": "/(en|mk)/invite/[a-zA-Z0-9]{8}/?", "dest": "/$1/invite/" },
    { "src": "/en/horoscope/([a-z]+)/\\d{4}-\\d{2}-\\d{2}/?", "status": 308, "headers": { "Location": "/en/horoscope/$1/" } },
    { "src": "/mk/dneven-horoskop/([a-z]+)/\\d{4}-\\d{2}-\\d{2}/?", "status": 308, "headers": { "Location": "/mk/dneven-horoskop/$1/" } }
  ]
}
