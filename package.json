{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:export": "NEXT_DIST_DIR=.next-export next build",
    "build:app": "node scripts/build-app.mjs",
    "cap:sync": "npm run build:app && cap sync",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:copy": "node scripts/check-copy.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "calibrate": "N_PEOPLE=3000 N_PAIRS=40000 tsx scripts/calibrate.ts",
    "cities": "node scripts/build-cities.mjs",
    "postbuild": "node scripts/prune-locale-shells.mjs && node scripts/postbuild-targets.mjs"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.117.3",
    "astronomy-engine": "^2.1.19",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lunar-javascript": "^1.7.7",
    "luxon": "^3.7.2",
    "motion": "^14.1.0",
    "next": "16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@electric-sql/pglite": "0.3.16",
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
